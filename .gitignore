# Configuração pessoal (caminhos do seu PC e do seu Drive). Copie painel.config.exemplo.json.
painel.config.json

# Colab CLI: recriados por colab-cli/instalar.sh (o bin/colab aponta para o venv do seu WSL)
colab-cli/_dl/
colab-cli/bin/
colab-cli/_voz/

# Notebooks salvos depois de rodar (têm saídas e caminhos da sua conta)
notebooks/*_output.ipynb

node_modules/
*.log
.env*
.DS_Store
Thumbs.db
desktop.ini

# Estado local do Colab: perfis que você salvou, sessões mantidas, histórico, logs e resultados baixados
colab-perfis.json
colab-cli/_estado.json
colab-cli/_historico.jsonl
colab-cli/_logs/
colab-cli/_blender/
# 3D por IA: token do Hugging Face, extensões compiladas no Colab e resultados baixados
colab-cli/_segredos/
colab-cli/_rodas/
colab-cli/_ia3d/
